            </div>
        </main>

        <%
            // 播放列的初始值由 server 直接渲染 (res.locals.media),換頁時才不會先閃一下 --/0:00
            const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
            const pct = media.duration > 0 ? Math.min(100, media.position / media.duration * 100) : 0;
        %>
        <footer class="player-bar" id="player-bar">
            <div class="player-left">
                <img src="<%= media.hasCover ? '/api/current-media/cover' : '/img/cover-placeholder.svg' %>" id="album-cover" alt="Cover" class="player-cover">
                <div class="player-info">
                    <div class="current-title" id="current-title"><%= media.title || '--' %></div>
                    <div class="current-artist" id="current-artist"><%= media.title ? (media.artist || 'Unknown Artist') : '--' %></div>
                </div>
            </div>
            <div class="player-center">
                <div class="player-controls">
                    <button class="media-btn toggle-btn <%= media.shuffle ? 'active' : '' %>" id="shuffle-btn" data-tip="隨機播放" onclick="mediaAction('shuffle')"><i class="fa-solid fa-shuffle"></i></button>
                    <button class="media-btn" data-tip="上一步" onclick="mediaAction('prev')"><i class="fa-solid fa-backward-step"></i></button>
                    <button class="media-btn play-pause-btn" data-tip="播放" onclick="mediaAction('playpause')"><i class="fa-solid <%= media.is_playing ? 'fa-pause' : 'fa-play' %>" id="play-pause-icon"></i></button>
                    <button class="media-btn" data-tip="下一步" onclick="mediaAction('next')"><i class="fa-solid fa-forward-step"></i></button>
                    <button class="media-btn toggle-btn <%= media.repeat ? 'active' : '' %>" id="repeat-btn" data-mode="<%= media.repeat %>" data-tip="循環播放" onclick="mediaAction('repeat')"><i class="fa-solid fa-repeat" id="repeat-icon"></i></button>
                </div>
                <div class="progress-container">
                    <span class="time-label" id="current-time"><%= fmt(media.position) %></span>
                    <div class="slider-wrapper">
                        <input type="range" id="progress-slider" min="0" max="100" step="0.01" value="<%= pct %>">
                        <!-- hover 預覽必須排在 fill 之前:兩者都是 positioned 且無 z-index,靠 DOM 順序讓綠色 fill 疊在上面 -->
                        <div class="progress-hover-fill" id="progress-hover"></div>
                        <div class="progress-bar-fill" id="progress-fill" style="width: <%= pct %>%"></div>
                        <div class="seek-tooltip" id="seek-tooltip"></div>
                    </div>
                    <span class="time-label" id="total-time"><%= fmt(media.duration) %></span>
                </div>
            </div>
            <div class="player-right">
                <!-- 備選歌詞放工具列最左:浮層以按鈕為中心展開,離視窗右緣越遠能開得越寬 -->
                <div class="lyrics-opt-wrap">
                    <%
                        // 備選歌詞鈕的初始樣子也由 server 決定 (搜尋中 = 轉圈,已搜到 = 綠色打勾),不然會閃一下
                        const optSearching = optState.status === 'searching';
                        const optReady = optState.status === 'done' && optState.count > 0;
                    %>
                    <button id="lyrics-opt-btn"
                            class="ctrl-btn <%= (optSearching || optReady) ? 'active' : '' %>"
                            <%= optSearching ? 'data-loading="1"' : '' %>
                            <%= optReady ? 'data-ready="1"' : '' %>
                            onclick="searchLyricsOptions()"
                            data-tip="<%= optReady ? '查看備選歌詞' : '搜尋備選歌詞' %>">
                        <i class="fa-solid <%= optSearching ? 'fa-spinner fa-spin' : (optReady ? 'fa-check' : 'fa-list') %>"></i>
                    </button>
                    <div id="lyrics-opt-bubble" class="lyrics-opt-bubble" onclick="openLyricsModal()"></div>
                    <%- include('modals/lyrics-options') %>
                </div>
                <button id="loop-mode-btn" class="ctrl-btn" onclick="toggleLoopMode()" data-tip="段落循環"><i class="fa-solid fa-bookmark"></i></button>
                <button id="toggle-ruby-mode-btn" class="ctrl-btn" onclick="toggleRubyEditMode()" data-tip="編輯假名模式"><i class="fa-solid fa-pen"></i></button>
                <button id="reload-btn" class="ctrl-btn" onclick="reloadCurrentLyrics()" data-tip="重新載入歌詞"><i class="fa-solid fa-rotate"></i></button>
                <button id="desktop-toggle-btn" class="ctrl-btn" onclick="toggleIsland()" data-tip="桌面靈動島">
                    <i class="fa-solid fa-mobile-screen"></i>
                </button>
                <button id="fullscreen-btn" class="ctrl-btn fullscreen-btn" onclick="toggleFullscreen()" data-tip="放大模式">
                    <i class="fa-solid fa-expand icon-expand"></i>
                    <i class="fa-solid fa-compress icon-compress"></i>
                </button>
            </div>
        </footer>
    </div>

    <!-- 吐司:每頁都要有 (工具列在每頁都能用;備選歌詞浮層掛在播放列的按鈕上) -->
    <div id="toast" class="toast hidden">
        <i id="toast-icon" class="fa-solid fa-circle-info"></i>
        <span id="toast-message"></span>
        <!-- 需要動作的吐司 (目前只有更新提醒) 才顯示;showToast 每次都會關掉它 -->
        <button id="toast-action" class="toast-action hidden"></button>
    </div>

    <script>
        // server 渲染的播放狀態:給 app.js 當起始值 (不然它會先用 0 秒/預設 3:00 畫一次,換頁就閃)
        window.__initialMedia = <%- JSON.stringify(media) %>;
        window.currentSongInfo = { title: window.__initialMedia.title, artist: window.__initialMedia.artist };

        // 羅馬字/譯文是否要併進廣播內容 (server 的 wantsExtraLine) 是「歌詞區開關 或 島的第二行
        // 選了它」——選了給島用時,即使歌詞區開關是關的,廣播內容照樣帶那一行 (不然島會是空的)。
        // 網頁的歌詞面板要自己再擋一次,只認這兩個開關本身,不能看「內容裡有沒有那一行」來決定要不要畫,
        // 否則 island_line2 設成 romaji/translation 時,關掉歌詞區的對應開關會沒有作用。
        window.__lyricsPaneSettings = { show_romaji: <%- !!settings.show_romaji %>, show_translation: <%- !!settings.show_translation %> };
    </script>
    <script src="/js/common.js?v=6"></script>
</body>
</html>
