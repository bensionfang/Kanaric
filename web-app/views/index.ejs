<%- include('header') %>

<!-- ================= 網頁版即時監控 ================= -->
<div id="web-mode-sec" class="mode-section animate-fade-in" style="display: flex; flex-direction: column; flex: 1; height: 100%; min-height: 0;">
    <!-- 滾動歌詞面板 -->
    <div class="lyrics-view-container" style="display: flex; flex-direction: column; flex: 1; min-height: 0; position: relative;">
        <details id="song-info" class="song-info" hidden>
            <summary>目前歌曲資訊</summary>
            <div class="song-info-body">
                <p>播放器：<span id="song-info-player">未知</span></p>
                <p>辨識歌曲：<span id="song-info-title"></span></p>
                <p id="song-info-original-row">原始名稱：<span id="song-info-original"></span></p>
                <p>歌詞狀態：<span id="song-info-status">等待播放</span></p>
                <p>歌詞來源：<span id="song-info-provider">來源未知</span></p>
                <div class="song-info-actions">
                    <button type="button" onclick="reloadCurrentLyrics()">重新載入歌詞</button>
                    <button type="button" onclick="searchLyricsOptions()">搜尋備選歌詞</button>
                    <button type="button" onclick="openMediaSourceSettings(event)">音訊來源</button>
                </div>
            </div>
        </details>
        <div class="lyrics-scroll-pane" id="lyrics-scroll" style="flex: 1; font-size: 24px; min-height: 0; padding-bottom: 100px;">
            <div class="lyrics-empty" id="lyrics-placeholder" role="status">
                <i class="fa-solid fa-music" aria-hidden="true"></i>
                <p>播放一首歌，歌詞就會顯示在這裡。</p>
                <button type="button" onclick="openMediaSourceSettings(event)">檢查音訊來源</button>
            </div>
        </div>
        
        <!-- Resume Sync Button -->
        <div id="sync-resume-panel" class="sync-resume-panel" style="display: none;">
            <button onclick="resumeSync()" title="恢復同步">
                <i class="fa-solid fa-location-arrow"></i> 恢復同步
            </button>
        </div>
    </div>
</div>

<!-- 歌詞時間軸微調 (每首歌獨立記憶):定位在 .main-content 右下角 -->
<div class="offset-panel" id="offset-panel">
    <button onclick="adjustSyncOffset(-0.1)" data-tip="歌詞慢了"><i class="fa-solid fa-minus"></i></button>
    <span id="offset-display" onclick="resetSyncOffset()" data-tip="點擊歸零">0 ms</span>
    <button onclick="adjustSyncOffset(0.1)" data-tip="歌詞快了"><i class="fa-solid fa-plus"></i></button>
</div>

<script src="/js/scroll-zone.js?v=4"></script>
<script src="/js/karaoke.js?v=2"></script>
<script src="/js/lrc-parse.js?v=1"></script>
<script src="/js/offset-sync.js?v=3"></script>
<script src="/js/app.js?v=63"></script>
<%- include('footer') %>
