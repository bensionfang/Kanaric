<!DOCTYPE html>
<!-- 假名開關由 server 直接渲染,做法與 header.ejs 相同 (載入就是對的,不會閃一下) -->
<html lang="zh-TW"<%- locals.settings && locals.settings.show_furigana === false ? ' class="hide-furigana"' : '' %>>
<head>
<meta charset="UTF-8">
<title>Kanaric Island</title>
<link rel="stylesheet" href="/css/island.css?v=21">
<!-- 逐字卡拉OK填色:與歌詞區、行動版共用同一份實作 -->
<script src="/js/karaoke.js?v=2"></script>
<script src="/js/offset-sync.js?v=3"></script>
</head>
<body>
<div id="island" class="docked">
  <!-- 上排要自己一個容器,不能靠 #island 的 flex-wrap 換行:wrap 的規則是「放不下就整個換行」
       而不是「先壓縮」,寬度過渡的那 0.32 秒島比內容窄,封面/歌詞/等化器會各自跳成一列。 -->
  <div id="top">
    <div id="art"></div>
    <div id="lines">
      <div id="l0"></div>
      <div id="song">等待播放…</div>
      <div id="l1" class="hidden"></div>
      <div id="l2" class="hidden"></div>
    </div>
    <!-- 右端的播放狀態:跟左端封面等寬,版面才左右平衡 (播放中跳動、暫停時定住) -->
    <div id="state"><i></i><i></i><i></i></div>
  </div>
  <!-- 展開 (hover) 才出現的控制列。島沒有載任何 icon font,圖示直接 inline SVG。
       外層 #ctrl 是「高度補間 + 裁切」的殼 (高度由 JS 設成真實 px 才補間得起來),
       內層 #ctrl-in 永遠保持自然高度 —— 展開前要先知道它多高,視窗才來得及長高。 -->
  <div id="ctrl"><div id="ctrl-in">
    <div id="btns">
      <button data-act="playpause" title="播放/暫停"><svg id="pp-icon" viewBox="0 0 24 24"><path d="M8 5h3v14H8zm5 0h3v14h-3z"/></svg></button>
      <button data-act="next" title="下一首"><svg viewBox="0 0 24 24"><path d="M15.5 6H18v12h-2.5zM5 6l9.5 6L5 18z"/></svg></button>
    </div>
    <div id="bar">
      <div id="bar-track"><div id="bar-fill"></div></div>
      <span id="bar-time">0:00 / 0:00</span>
    </div>
  </div></div>
</div>
<div id="measure"></div>

<script>
const el = {
  island: document.getElementById('island'), art: document.getElementById('art'),
  song: document.getElementById('song'), l1: document.getElementById('l1'), l2: document.getElementById('l2'),
  l0: document.getElementById('l0'), state: document.getElementById('state'),
  top: document.getElementById('top'),
  ctrl: document.getElementById('ctrl'), ctrlIn: document.getElementById('ctrl-in'),
  btns: document.getElementById('btns'),
  bar: document.getElementById('bar'), track: document.getElementById('bar-track'),
  fill: document.getElementById('bar-fill'), time: document.getElementById('bar-time'),
  ppIcon: document.getElementById('pp-icon'),
  measure: document.getElementById('measure')
};

// 展開時控制列本身要放得下,歌詞比它短時視窗不能縮到切掉按鈕。
// 控制列收成一行之後進度條要跟按鈕與時間共用寬度,240 只剩 96px 的軌道,點不太準 —— 300 才夠。
const CTRL_MIN_W = 300;
// 提早換行的補償秒數 (見 frame())。等於 .lyric-anim 的長度,不要再放大 ——
// 每一句的最後 LEAD 秒是填不到色的,放大就是把逐字填色的尾巴吃掉。
const LEAD = 0.2;
// 沒內容的佔位行:展開時用來把行數固定住 (見 updateL0 / setLine2)
const BLANK = '&nbsp;';

// ── 量測:一首歌只量一次,結果存起來 ────────────────────────────
// **重點是「換行那一幀不再量任何東西」**,不是量得比較快:量一次是「寫 innerHTML →
// 讀 offsetWidth」的成對操作,每一次讀都強制一次 layout,而換行那一幀同時還在跑淡入動畫
// 與逐字填色。改成查表之後換行那一幀只剩一次 layout (實測 0.4ms)。
let wMain = new Map();   // 這句當「主行」(#song/#l1 的字級字重) 時的自然寬
let wSub = new Map();    // 這句當「上一句/第二行」(#l0/#l2 的字級) 時的自然寬
let chromeW = 0;         // 封面 + 等化器 + 兩個 gap + 左右 padding,字級固定所以是常數
let songMaxW = 0;

function measureChrome() {
  const cs = getComputedStyle(el.island);
  const gap = parseFloat(getComputedStyle(el.top).gap) || 12;   // 三個元素的間距掛在 #top
  chromeW = el.art.offsetWidth + el.state.offsetWidth + gap * 2
    + parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
}

const pillFor = (w) => Math.ceil(w + chromeW) + 2;   // +2 避免尾字被四捨五入切掉
const pillForLines = (line1, line2) =>
  pillFor(Math.max(line1 ? textW(line1, false) : 0, line2 ? textW(line2, true) : 0));

// 一次量完一批字串:先全部寫進 DOM,再一次讀完所有寬度。
// 每個字串量兩份:同一句當主行與當第二行的字級不同,寬度也不同。
// (量過:100 行 + 譯文 + 羅馬字 = 300 個字串,批次 40ms、兩顆節點交錯讀寫 43ms —— 兩者
//  差不多,成本在 HTML parse 與 ruby 排版,不在 layout 次數。換歌一首才跑一次,夠用。)
function measureAll(strings) {
  if (!strings.length) return;
  const f1 = getComputedStyle(el.l1), f2 = getComputedStyle(el.l2);
  const frag = document.createDocumentFragment();
  const nodes = [];
  for (const s of strings) {
    for (const f of [f1, f2]) {
      const d = document.createElement('div');
      d.innerHTML = s;
      d.style.fontSize = f.fontSize;
      d.style.fontWeight = f.fontWeight;   // 主行是 500,量在預設 400 上會少算幾 px
      frag.appendChild(d);
      nodes.push(d);
    }
  }
  el.measure.appendChild(frag);
  for (let i = 0; i < strings.length; i++) {
    wMain.set(strings[i], nodes[i * 2].offsetWidth);
    wSub.set(strings[i], nodes[i * 2 + 1].offsetWidth);
  }
  el.measure.textContent = '';
}

// 查表拿自然寬。查不到的 (歌名、換歌詞前的殘留字串) 現場補量一次當退路
function textW(html, sub) {
  const map = sub ? wSub : wMain;
  if (!map.has(html)) measureAll([html]);
  return map.get(html) || 0;
}

// 換歌時一次量完整首:視窗寬度整首定死在最寬那一行 (零閃),逐行切換只動藥丸的 CSS 寬度、
// 不動視窗。每一句都可能當 line1 或 line2 出現,所以歌詞、譯文、羅馬字全都要量。
function measureSong() {
  wMain = new Map();
  wSub = new Map();
  measureChrome();
  const all = new Set();
  for (const it of lyrics) if (it.html) all.add(it.html);
  for (const t in translations) all.add(translations[t]);
  for (const t in romajis) all.add(romajis[t]);
  measureAll([...all]);
  songMaxW = 0;
  for (const w of wMain.values()) songMaxW = Math.max(songMaxW, pillFor(w));
  // 這首歌有沒有注音 —— 決定「沒有 ruby 的行要不要補高度」(見 island.css 的 .no-ruby)。
  // 中文歌整首都沒有 ruby,不判斷的話每一行都補,整個島白白高一截。
  el.island.classList.toggle('has-ruby', [...all].some((s) => s.includes('<rt')));
}

let lastResize = '';   // 上一次真的送出去的尺寸,一樣就不再送 (見下面)

// 高度直接量 #island 自己 (height:auto),ruby、行數、字級都自動貼合。
// windowW 給定時 (歌詞模式) 視窗寬固定為整首最寬,藥丸的 CSS 寬照樣是本行實際寬 → 短行居中、
// 兩側透明,不留黑空隙。沒給 (歌名/前奏/設定) 就用本行寬,視窗剛好貼合。
function fitSize(pillW, growOnly = false, windowW = null) {
  if (expanded) {
    // 展開時藥丸寬**固定成整首最寬**(至少放得下控制列):hover 期間換句時按鈕與進度條
    // 不可以左右跳,而使用者正要去點它們。
    pillW = Math.max(pillW, songMaxW, CTRL_MIN_W);
    if (windowW != null) windowW = Math.max(windowW, pillW);
  }
  // 藥丸寬度用 CSS transition 平滑補間
  el.island.style.width = pillW + 'px';
  // 展開動畫還在跑時 #ctrl 只有一半高,量到的島高會偏小 —— 視窗一律照「完全展開」算,
  // 免得動畫中途有換行進來、把控制列切在視窗外面。兩個讀都在同一次 layout 之後,不多花成本。
  const height = Math.ceil(el.island.offsetHeight)
    + (expanded ? Math.max(0, ctrlH - el.ctrl.offsetHeight) : 0);
  const width = windowW != null ? windowW : pillW;
  // 藥丸自己的尺寸給主進程做「游標在不在島上」的命中判定 (透明區點擊穿透)。
  // **要在下面那個早退之前送** —— 視窗寬在歌詞模式下固定為整首最寬、逐句不變,
  // 但藥丸寬是逐句在變的,跟著早退就送不出去,短行的兩側會一直被當成島。
  bridge.pill({ w: pillW, h: height });
  // 三個值都沒變就不送:主進程雖然有 8px 死區會丟掉,但那是「送完才丟」,白花一次跨進程訊息。
  // **growOnly 也要比對** —— 它會改主進程的 maxW/maxH 狀態,值一樣但旗標不同時不可以省。
  const sig = width + '|' + height + '|' + growOnly;
  if (sig === lastResize) return;
  lastResize = sig;
  bridge.resize({ width, height, growOnly });
}

// 依目前畫面上顯示的是歌名還是歌詞,重新回報尺寸 (展開/收合、l0 出現消失時用)。
// hold = 收合動畫期間先不要縮視窗 (走 growOnly),多出來的那段是透明的,看不見。
function refit(hold = false) {
  if (!el.song.classList.contains('hidden')) {
    return fitSize(pillForLines(el.song.textContent, ''), hold);
  }
  fitSize(pillForLines(lastLine1, lastLine2), hold, songMaxW);
}

// preload 只有在 Electron 島視窗裡才存在;用瀏覽器直接開 /island 除錯時降級成空實作
const bridge = window.islandBridge || {
  dragStart() {}, dragEnd() {}, toggleDock() {}, resize() {}, onDocked() {},
  pill() {}, onHover() {}
};

// ── 拖曳:自己判斷有沒有真的移動,幾乎沒動就當成單擊 (切換吸附) ──
let downAt = null;
document.addEventListener('mousedown', (e) => {
  // 控制列上的按下不啟動拖曳,也不會被 mouseup 當成單擊去切吸附 (downAt 留 null)
  if (e.target.closest('#ctrl')) return;
  downAt = { x: e.screenX, y: e.screenY };
  bridge.dragStart();
});
document.addEventListener('mouseup', (e) => {
  if (!downAt) return;
  const moved = Math.abs(e.screenX - downAt.x) > 2 || Math.abs(e.screenY - downAt.y) > 2;
  downAt = null;
  bridge.dragEnd();
  if (!moved) bridge.toggleDock();
});
bridge.onDocked(d => el.island.classList.toggle('docked', d));

// ── 展開模式:滑鼠移上去 = 上一句 + 控制列 + 進度條,移開收回 ──
// 「在不在藥丸上」由主進程輪詢游標算 (見 island.js 的透明區點擊穿透):藥丸以外的地方
// 是穿透的,收不到 mouseenter/mouseleave,而且離開藥丸的那一瞬間正好會被切成穿透 ——
// 用 DOM 事件的話 mouseleave 有機會整個收不到,島就卡在展開狀態。
// **進出都要延遲**:沒有延遲的話滑鼠掃過螢幕上緣就彈開一次,停在藥丸邊緣還會展開/收合
// 來回彈 (島的寬度本來就會隨歌詞變)。
const HOVER_IN = 180, HOVER_OUT = 220;
const CTRL_ANIM = 300;   // 收合動畫跑完才縮視窗,要 ≥ CSS 的 transition 長度
let hoverIn = null, hoverOut = null, shrinkTimer = null, ctrlH = 0;

function onHover(on) {
  if (on) {
    clearTimeout(hoverOut); hoverOut = null;
    if (expanded || hoverIn) return;
    hoverIn = setTimeout(() => { hoverIn = null; setExpanded(true); }, HOVER_IN);
  } else {
    clearTimeout(hoverIn); hoverIn = null;
    if (!expanded || hoverOut) return;
    hoverOut = setTimeout(() => { hoverOut = null; setExpanded(false); }, HOVER_OUT);
  }
}
bridge.onHover(onHover);
// 用瀏覽器直接開 /island 除錯時沒有主進程,退回 DOM 事件 (那裡也沒有穿透問題)
if (!window.islandBridge) {
  el.island.addEventListener('mouseenter', () => onHover(true));
  el.island.addEventListener('mouseleave', () => onHover(false));
}

function setExpanded(on) {
  // 猜歌中不展開:控制列的「下一首」會打亂遊戲自己的切歌流程 (game.js 用同一支 API)
  if (on && gameMask) return;
  if (on === expanded) return;
  clearTimeout(shrinkTimer);
  expanded = on;
  el.island.classList.toggle('expanded', on);
  updateL0();
  setLine2(lastLine2);
  updateProgress();
  // 控制列的高度由 JS 設成真實 px,CSS 才補間得動 (height:auto 不會補間)。
  // 量的是內層那顆 —— 外層被裁成 0 高,量它永遠是 0。
  ctrlH = el.ctrlIn.offsetHeight || ctrlH;
  el.ctrl.style.height = on ? ctrlH + 'px' : '0px';
  // 展開:視窗高度要在動畫**開始前**就到位,否則控制列會被視窗下緣切掉 (fitSize 自己補)。
  // 收合:動畫期間先維持現在的高度 (growOnly),跑完再縮回去。
  refit(!on);
  if (!on) shrinkTimer = setTimeout(() => refit(), CTRL_ANIM);
}

// 上一句:往回找最近一句有字的。顯示歌名 (前奏/剛換歌) 時不顯示 —— 那時「上一句」沒有意義。
// 展開時即使找不到 (還在第一句) 也要留一列空的,否則唱到第二句時控制列會整個往下跳。
function updateL0() {
  const onLyrics = expanded && el.song.classList.contains('hidden');
  let html = '';
  if (onLyrics && curIdx > 0) {
    for (let k = curIdx - 1; k >= 0; k--) if (lyrics[k].html) { html = lyrics[k].html; break; }
  }
  el.l0.innerHTML = html || (onLyrics ? BLANK : '');
  markRuby(el.l0, html);
  el.l0.style.width = html ? textW(html, true) + 'px' : '0px';
  el.l0.classList.toggle('has', !!html || onLyrics);
}

// 第二行:有內容就畫。沒有內容時,展開狀態下照樣要佔一列 —— 理由同 updateL0,
// hover 期間換到「沒有下一句」的那行時,控制列不可以往上跳。
function setLine2(html) {
  if (html) return paint(el.l2, html, true);
  if (expanded && islandLines === 2 && el.song.classList.contains('hidden')) {
    el.l2.innerHTML = BLANK;
    markRuby(el.l2, BLANK);
    el.l2.style.width = '0px';
    el.l2.classList.remove('hidden', 'lyric-anim');
  } else el.l2.classList.add('hidden');
}

function fmtTime(s) {
  s = Math.max(0, Math.floor(s));
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
}

// 進度用的位置**不套 offset 也不套那 0.5 秒補償** —— 那兩個是歌詞對齊用的,不是真實播放位置
function playPos() {
  return pos + (playing ? (performance.now() - lastSync) / 1000 : 0);
}

let lastTimeText = '';
function updateProgress() {
  if (!expanded) return;
  // 瀏覽器 (YouTube) 來源拿不到時長,整條收起來只留按鈕 —— 畫一條永遠是 0 的進度條更糟
  el.bar.classList.toggle('hidden', !duration);
  if (!duration) return;
  const t = Math.min(duration, playPos());
  // **用 transform 不用 width** —— 這是每一幀都在寫的東西,寫 width 每幀都要重新排版
  // #bar,寫 transform 只動合成層。代價是 2px 的圓角端點會被橫向壓扁,4px 高的細條看不出來。
  el.fill.style.transform = 'scaleX(' + (t / duration) + ')';
  const txt = fmtTime(t) + ' / ' + fmtTime(duration);
  if (txt !== lastTimeText) el.time.textContent = lastTimeText = txt;   // 每秒才變,不必每幀寫
}

el.btns.addEventListener('click', (e) => {
  const b = e.target.closest('button');
  if (b) post('/api/media-control', { action: b.dataset.act });
});

// 點擊 seek 就夠用。ponytail: 要拖曳刷桿再加 pointermove
el.track.addEventListener('click', (e) => {
  if (!duration) return;
  const r = el.track.getBoundingClientRect();
  const target = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * duration;
  pos = target; lastSync = performance.now();   // 先自己跳過去,不等監控回報 (它有 0.1 秒延遲)
  updateProgress();
  post('/api/seek', { position: target });
});

function post(url, body) {
  fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .catch(() => {});
}

// ── 狀態 ──
let lyrics = [], songKey = '', pos = 0, playing = false, lastSync = 0, offset = 0, duration = 0;
let expanded = false, curIdx = -1;   // curIdx = 目前唱到第幾句 (展開時要往回找上一句)
let lastThumb = null;   // 已套用的封面 —— 縮圖可能換歌後晚一拍才由 media_monitor 補送
let gameMask = false;   // 猜歌遊戲進行中:歌名與歌詞都要遮起來,否則島直接公布答案
let islandLines = 2, lastLine1 = null, lastLine2 = '', idleTimer = null, wasPlaying = null, wasHasSession = null;
// 第二行顯示什麼:'next' 下一句歌詞 (預設) / 'translation' 本句翻譯
let islandLine2 = 'next';
// 時間戳 -> 譯文。譯文行不進 lyrics[],否則會被當成獨立一句輪播過去
let translations = {};
let romajis = {};
let words = {};          // 逐字時間:時間戳 -> [[字元索引, 相對毫秒], …]

let _lastDisplaySettings = null;
function applySettings(s) {
  if (!s) return;
  // 島的字級固定(見 island.css 的 --island-fs),不跟主頁 font_size 連動:主頁放大是為了
  // 細讀,島要永遠保持「一條細帶」。兩者需求相反,綁在一起會互相破壞。
  // 透明度是純 CSS 變數 (只改底色 alpha),不會重排,永遠先套用。
  const op = s.island_opacity === undefined ? 1 : Number(s.island_opacity);
  document.documentElement.style.setProperty('--island-opacity', isNaN(op) ? 1 : op);

  // 只有「影響版面」的設定變了才重排 —— 重排會 lastLine1=null 重播歌詞淡入 + 重量尺寸,
  // 而重量尺寸會 setBounds 讓透明視窗閃一下。位置類設定 (island_x/y/docked) 存檔也會廣播
  // settings_updated,不擋的話拖曳一放開島就對自己存的位置做整套重排 → 閃。
  const disp = `${s.show_furigana}|${s.island_lines}|${s.island_line2}`;
  if (disp === _lastDisplaySettings) return;
  _lastDisplaySettings = disp;

  document.documentElement.classList.toggle('hide-furigana', s.show_furigana === false);
  islandLines = Number(s.island_lines) === 1 ? 1 : 2;
  islandLine2 = (s.island_line2 === 'translation' || s.island_line2 === 'romaji') ? s.island_line2 : 'next';
  // 行數只在「換行時」才會被套用 (frame() 判到 line1 沒變就提早 return),
  // 所以這裡要自己收掉第二行,並清掉 lastLine1 讓下一幀重畫 (1 → 2 行時把內容補回來)
  if (islandLines === 1) { el.l2.classList.add('hidden'); lastLine2 = ''; }
  lastLine1 = null;
  // 假名開關會改變每行的 ruby 寬度,整首的行寬要全部重量,否則零閃的視窗寬會用到舊值
  if (lyrics.length) measureSong();
  // 有歌詞的話下一幀重畫時就會回報尺寸;停在歌名畫面 (前奏/剛換歌) 沒有重畫,自己報一次
  if (!el.song.classList.contains('hidden')) showName(el.song.textContent);
}

// ── WebSocket:歌曲狀態、歌詞、設定、時間軸偏移全部靠推播 ──
function connect() {
  const ws = new WebSocket(`ws://${location.host}`);
  ws.onmessage = (ev) => {
    let msg; try { msg = JSON.parse(ev.data); } catch (e) { return; }
    if (msg.type === 'init' || msg.type === 'media_state') {
      if (msg.settings) applySettings(msg.settings);
      onMediaState(msg.state || {});
    } else if (msg.type === 'lyrics_updated') {
      // 猜歌中連別的分頁抓歌詞的廣播也要擋 —— 島是置頂的,歌詞裡多半唱著歌名
      if (!gameMask && msg.artist + '|||' + msg.title === songKey) setLyrics(msg.lyrics || '');
    } else if (msg.type === 'game_state') {
      gameMask = !!msg.active;
      lyrics = []; lastLine1 = null; curIdx = -1;
      if (gameMask) setExpanded(false);   // 開局時滑鼠正停在島上的話,控制列要收掉
      if (gameMask) showSongName('', '');
      else songKey = '';   // 清掉才會被下一次 media_state 當成換歌,重抓歌名與歌詞
    } else if (msg.type === 'settings_updated') {
      applySettings(msg.settings);
    } else if (msg.type === 'sync_offset_updated') {
      const liveOffset = offsetFromMessage(songKey, msg);
      if (liveOffset !== null) offset = liveOffset;
    }
  };
  ws.onclose = () => { el.song.textContent = '伺服器斷線'; setTimeout(connect, 3000); };
  ws.onerror = () => ws.close();
}
connect();

async function onMediaState(m) {
  playing = !!m.is_playing;
  pos = m.position || 0;
  duration = m.duration || 0;
  lastSync = performance.now();
  // 暫停 3 秒後淡出,恢復播放立刻淡回來。
  // **只在狀態真的改變時才動計時器**:media_monitor 每 0.1 秒就回報一次,
  // 每次都 clearTimeout 的話那 3 秒永遠數不完,島就一直不會淡出。
  //
  // 「無播放來源 (等待播放)」與「有歌但暫停」都淡出:非播放狀態一律排 3 秒淡出計時器,
  // 使用者要的行為就是「等待時跟暫停一樣先隱藏」。恢復播放立刻淡回。
  const hasSession = !!m.title;
  if (playing !== wasPlaying || hasSession !== wasHasSession) {
    wasPlaying = playing;
    wasHasSession = hasSession;
    el.island.classList.toggle('playing', playing);   // 右端等化器動不動看這個
    // 控制列中間那顆:播放中顯示暫停符號,暫停中顯示播放符號
    el.ppIcon.innerHTML = playing
      ? '<path d="M8 5h3v14H8zm5 0h3v14h-3z"/>'
      : '<path d="M8 5l11 7-11 7z"/>';
    clearTimeout(idleTimer);
    if (playing) el.island.classList.remove('idle');
    else idleTimer = setTimeout(() => el.island.classList.add('idle'), 3000);
  }

  // 播放來源整個消失 (音樂 app 關掉了):收乾淨舊歌詞狀態並退回「等待播放…」文字。
  // 島此時已排程淡出,文字淡出後看不到,但狀態還是要清,不然淡回時會閃到上一首歌詞。
  if (!m.title) {
    if (songKey !== '') {
      songKey = ''; lyrics = []; lastLine1 = null; lastThumb = '';
      el.art.style.backgroundImage = '';
      showName('等待播放…');
    }
    return;
  }

  // 封面獨立更新,不綁在換歌那一刻:縮圖偶爾換歌後才由 media_monitor 補送 (winrt 非同步),
  // 只在換歌設一次的話,那一首就整首沒封面。同一首也要吃這個晚到的縮圖。
  if (m.thumbnail !== undefined && m.thumbnail !== lastThumb) {
    lastThumb = m.thumbnail;
    el.art.style.backgroundImage = m.thumbnail ? `url(data:image/png;base64,${m.thumbnail})` : '';
  }

  // resolving = 歌名還沒定案 (iTunes 日文原名還原中),等定案再抓,否則會抓兩次
  const key = (m.artist || '') + '|||' + (m.title || '');
  if (m.resolving || key === songKey) return;
  songKey = key;
  lyrics = []; lastLine1 = null;
  showSongName(m.title, m.artist);
  if (gameMask) return;   // 猜歌中:歌名已被遮蔽,歌詞也不抓

  const q = new URLSearchParams({ title: m.title, artist: m.artist });
  try {
    const d = await (await fetch('/api/lyrics/fetch?' + q)).json();
    if (songKey === key) setLyrics(d.lyrics || '');
  } catch (e) {}
  try {
    const o = await (await fetch('/api/lyrics/offset?' + q)).json();
    if (songKey === key) offset = o.offset || 0;
  } catch (e) {}
}

// 切到「顯示歌名」的畫面:前奏、剛換歌、沒有播放來源共用這一支
function showName(text) {
  el.song.textContent = text;
  el.song.style.width = textW(text, false) + 'px';
  el.song.classList.remove('hidden');
  el.l1.classList.add('hidden');
  el.l2.classList.add('hidden');
  lastLine2 = '';
  curIdx = -1; updateL0();
  fitSize(pillForLines(text, ''));
}

function showSongName(title, artist) {
  // 猜歌遊戲進行中,島直接寫著答案 —— 一律換成固定字樣
  showName(gameMask ? '猜歌中' : (artist ? `${title} - ${artist}` : title));
}

function setLyrics(text) {
  lyrics = parseLrc(text);
  lastLine1 = null;
  measureSong();   // 整首的行寬先量好存起來 → 換行那一幀不必再量 (零閃、不掉幀)
}

function parseLrc(text) {
  const out = [];
  translations = {};
  romajis = {};
  words = {};
  for (const line of text.split('\n')) {
    const m = line.match(/^((?:\[\d+:\d+(?:\.\d+)?\])+)(.*)$/);
    if (!m) continue;
    const html = m[2].trim();
    if (html.startsWith('#TITLE#')) continue;   // 製作人員列不進島
    for (const tag of m[1].match(/\[\d+:\d+(?:\.\d+)?\]/g) || []) {
      const [mm, ss] = tag.slice(1, -1).split(':');
      const t = parseInt(mm) * 60 + parseFloat(ss);
      // 譯文與原句共用時間戳,收進對照表而不是當成獨立一句
      if (html.startsWith('#TRANS#')) translations[t] = html.substring(7);
      // 羅馬拼音同樣共用時間戳,收進對照表 (第二行選它時才畫)。**一定要吃掉** ——
      // 當成獨立一句的話,島上每句歌詞後面都會跟著一行羅馬字閃過去。
      else if (html.startsWith('#ROMAJI#')) romajis[t] = html.substring(8);
      // 逐字時間:同樣共用時間戳,收進對照表給卡拉OK填色用。**一定要吃掉** ——
      // 不然島上每句後面會跟著一行數字閃過去
      else if (html.startsWith('#WORDS#')) {
        words[t] = html.substring(7).split(',').map((p) => {
          const [idx, ms] = p.split(':');
          return [parseInt(idx, 10), parseInt(ms, 10)];
        }).filter(([idx, ms]) => Number.isFinite(idx) && Number.isFinite(ms));
      }
      else out.push({ t, html });
    }
  }
  return out.sort((a, b) => a.t - b.t);
}

function pickLines(i) {
  // 先決定「第一行實際是哪一句」:活躍位置落在空行 (間奏) 時先看後面,沒有再往回找。
  // **這一步一定要在挑第二行之前** —— 舊版是先用 lyrics[i] 去查譯文/羅馬字,間奏時 line1
  // 是空的所以整段跳過,接著才把下一句提上來當 line1,第二行就只剩「再下一句」。
  // 症狀:每次經過音符符號,那一句的第二行就從羅馬拼音/翻譯變成下一句歌詞。
  let idx = i;
  if (!lyrics[i].html) {
    idx = -1;
    for (let k = i + 1; k < lyrics.length; k++) if (lyrics[k].html) { idx = k; break; }
    if (idx < 0) for (let k = i - 1; k >= 0; k--) if (lyrics[k].html) { idx = k; break; }
    if (idx < 0) return ['', '', -1];
  }
  const line1 = lyrics[idx].html;

  // 第二行選「本句翻譯」或「本句羅馬拼音」時優先用它;這首歌沒有的話照舊退回
  // 「下一句歌詞」,不然切了設定卻整片空白,看起來像壞掉
  if (islandLine2 !== 'next') {
    const alt = (islandLine2 === 'romaji' ? romajis : translations)[lyrics[idx].t];
    if (alt) return [line1, alt, idx];
  }
  // 「下一句歌詞」最多往後看兩句 (中間夾一個空行還算數),再遠的就跟現在這句沒關係了
  let line2 = '';
  for (let k = idx + 1; k <= idx + 2 && k < lyrics.length; k++) {
    if (lyrics[k].html) { line2 = lyrics[k].html; break; }
  }
  return [line1, line2, idx];
}

// 換一行的內容。**寬度要寫死成這一行的自然寬** —— 藥丸寬度補間的那 0.32 秒,行本身的
// layout 就不會跟著變,ruby 與逐字 span 不必每幀重排 (#lines 只負責把超出的裁掉)。
// 重播淡入動畫需要的那次強制 reflow 由呼叫端統一做一次 (見 frame())。
// 沒有 ruby 的行,展開時要自己補上注音佔的那一截高度 (見 island.css 的 .no-ruby)
const markRuby = (node, html) => node.classList.toggle('no-ruby', !html.includes('<rt'));

function paint(node, html, sub) {
  node.innerHTML = html;
  markRuby(node, html);
  node.style.width = textW(html, sub) + 'px';
  // innerHTML 換掉了,karaokeSplit 記在元素上的那份切分結果全是死掉的節點 —— 一定要作廢,
  // 不然填色會去改上一句的 span (畫面上什麼都不會動,而且沒有錯誤訊息)
  node.__kc = null;
  node.__kcNow = null;
  node.classList.remove('hidden', 'lyric-anim');
}

// 島沒有 DevTools 可開 (無邊框視窗),留一個查狀態的入口:瀏覽器開 /island 或主進程都能問
window.__islandDebug = () => ({ songKey, lines: lyrics.length, pos, duration, playing, offset, islandLines, lastLine1, expanded, curIdx });

// 進度用 rAF 內插,跟網頁同一套做法,免得一秒才跳一次
function frame() {
  requestAnimationFrame(frame);
  // 進度條要在歌詞的早退之前更新:找不到歌詞的歌、瀏覽器來源,進度照樣要走
  updateProgress();
  if (!lyrics.length) return;
  // 早一點切換:抵銷淡入動畫,看起來才「跟手」。**這個值直接吃掉逐字填色的尾巴** ——
  // 島提早 LEAD 秒換行,而填色用的是真實播放位置,所以每一句的最後 LEAD 秒永遠填不到。
  // 舊值 0.5 是從 C# 島沿用的 (那時還沒有逐字填色):快歌一句才 1.2 秒,等於最後四成的字
  // 都還沒亮就跳下一句了 (2026-08-04 回報)。改成 0.2 = `.lyric-anim` 的實際長度,
  // 它本來就是這個補償要抵銷的東西。
  // ponytail: 剩下的 0.2 秒尾巴還在,要完全消掉得讓填色用「被壓縮的時間軸」提前跑完,
  //           那會讓每個字都亮得比唱得早,不划算。
  const now = pos + (playing ? (performance.now() - lastSync) / 1000 : 0) - offset + LEAD;
  if (now < lyrics[0].t) {                    // 前奏:顯示歌名
    if (lastLine1 !== 'INTRO') { lastLine1 = 'INTRO'; showName(el.song.textContent); }
    return;
  }
  let i = -1;
  for (let k = 0; k < lyrics.length; k++) if (lyrics[k].t <= now) i = k; else break;
  if (i < 0) return;
  const [line1, line2, idx] = pickLines(i);
  if (line1 !== lastLine1) {
    // 上一個狀態也是歌詞行才 grow-only;從前奏歌名 (通常較寬) 切到第一句歌詞要允許縮
    const fromLyric = lastLine1 !== null && lastLine1 !== 'INTRO';
    lastLine1 = line1;
    curIdx = i;
    el.song.classList.add('hidden');
    paint(el.l1, line1, false);
    updateL0();
    lastLine2 = (line2 && islandLines === 2) ? line2 : '';
    setLine2(lastLine2);
    // 逐行切換:視窗寬固定為整首最寬 (零閃),藥丸靠 CSS 縮到本行寬;高度 grow-only。
    // **展開中不回報尺寸** —— 幾何是凍結的 (見 fitSize 與 updateL0/setLine2 的佔位行),
    // 每句改一次視窗會讓按鈕在使用者手下移位,而且透明視窗改尺寸會閃。
    // 但「歌名 → 第一句歌詞」那次要報:行數從 1 變 3,不報的話控制列會被視窗切掉。
    if (!expanded || !fromLyric) fitSize(pillForLines(line1, lastLine2), fromLyric, songMaxW);
    else void el.island.offsetWidth;
    // 淡入動畫要重播,必須讓瀏覽器看到「class 被移除過」的狀態 —— 上面那次讀 layout
    // (fitSize 量高度 / void offsetWidth) 就是那道分隔,兩件事共用同一次 reflow。
    el.l1.classList.add('lyric-anim');
    if (lastLine2) el.l2.classList.add('lyric-anim');
  }
  // 卡拉OK填色:**每一幀都要跑,而且要排在重繪之後** (換行那一幀 el.l1 的內容剛換掉)。
  // 用 now - 0.5 而不是 now —— 那 0.5 秒是「提早換行來抵銷淡入動畫」的補償,
  // 不是真實播放位置,拿它去填色整句會快半秒。
  if (idx >= 0) karaokePaint(el.l1, words[lyrics[idx].t], (now - LEAD - lyrics[idx].t) * 1000);
}
measureChrome();   // 字級固定,所以量一次就夠 (measureSong 換歌時會再確認一次)
requestAnimationFrame(frame);
</script>
</body>
</html>
